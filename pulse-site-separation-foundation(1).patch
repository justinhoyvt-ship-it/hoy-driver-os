+        <a href="privacy.html">Privacy</a>
+        <a href="terms.html">Site notes</a>
+        <a href="mailto:justinhoyvt@gmail.com">Contact</a>
+      </div>
+    </div>
+  </footer>
+
+  <script>
+    (function(){
+      var root=document.documentElement;
+      var buttons=[].slice.call(document.querySelectorAll('[data-theme-choice]'));
+      var cycleTimer=null;
+
+      function liveTheme(){
+        var hour=new Date().getHours();
+        if(hour<7)return 'sunrise';
+        if(hour<17)return 'day';
+        if(hour<21)return 'sunset';
+        return 'night';
+      }
+      function setTheme(theme,pressed){
+        root.setAttribute('data-theme',theme);
+        buttons.forEach(function(button){
+          button.setAttribute('aria-pressed',String(button.getAttribute('data-theme-choice')===pressed));
+        });
+        var meta=document.querySelector('meta[name="theme-color"]');
+        var colors={sunrise:'#241335',day:'#77B7D8',sunset:'#30214D',night:'#070B1D'};
+        if(meta)meta.setAttribute('content',colors[theme]||colors.sunrise);
+      }
+      function startLive(){
+        clearInterval(cycleTimer);
+        setTheme(liveTheme(),'live');
+        cycleTimer=setInterval(function(){setTheme(liveTheme(),'live');},60000);
+      }
+      buttons.forEach(function(button){
+        button.addEventListener('click',function(){
+          var choice=button.getAttribute('data-theme-choice');
+          clearInterval(cycleTimer);
+          if(choice==='live')startLive();else setTheme(choice,choice);
+        });
+      });
+      if(new URLSearchParams(location.search).get('submitted')==='1'){
+        document.getElementById('successMessage').classList.add('show');
+      }
+    })();
+  </script>
+</body>
+</html>
