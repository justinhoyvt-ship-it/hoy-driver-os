+
+    <section class="interest" id="interest">
+      <div class="wrap interest-inner">
+        <div>
+          <p class="eyebrow">03 / Interest list</p>
+          <h2 style="margin-top:18px">Follow the build.</h2>
+          <p class="interest-copy">Add your email for occasional project updates, feedback invitations, or future local co-op testing.</p>
+          <p class="interest-note">This is an interest form. It does not request or reserve a ride.</p>
+        </div>
+
+        <form name="pulse-interest" method="POST" action="/index.html?submitted=1#interest" data-netlify="true" netlify-honeypot="bot-field">
+          <input type="hidden" name="form-name" value="pulse-interest">
+          <p class="honeypot"><label>Leave empty <input name="bot-field"></label></p>
+          <div class="success" id="successMessage">Email received. You are on the project list.</div>
+
+          <div class="field">
+            <label for="email">Email</label>
+            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
+          </div>
+
+          <div class="field">
+            <label for="interest-type">Interest</label>
+            <select id="interest-type" name="interest_type" required>
+              <option value="">Choose one</option>
+              <option>Local community member</option>
+              <option>Experienced driver</option>
+              <option>Community organization</option>
+              <option>Following the project</option>
+            </select>
+          </div>
+
+          <div class="field">
+            <label for="area">Town or general area — optional</label>
+            <input id="area" name="area" type="text" autocomplete="address-level2" placeholder="Essex, Burlington, Winooski…">
+          </div>
+
+          <button class="submit" type="submit">Add email</button>
