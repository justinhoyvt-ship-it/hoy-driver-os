}

function forgeStagePulse077EngineFromMain() {
  const active = forgeGetActiveEngineSlot_();
  const target = active === 'ENGINE_A' ? 'ENGINE_B' : 'ENGINE_A';
  const project = forgeRegistryGetProject_(target);
  const current = forgeGetScriptContent(project.scriptId);
  const engineManifest = {
    timeZone: 'America/New_York',
    dependencies: {},
    exceptionLogging: 'STACKDRIVER',
    runtimeVersion: 'V8',
    executionApi: { access: 'MYSELF' },
    oauthScopes: [
      'https://www.googleapis.com/auth/script.external_request',
      'https://www.googleapis.com/auth/spreadsheets',
      'https://www.googleapis.com/auth/drive.readonly'
    ]
  };
  const files = [
    {
      name: 'ForgeCore',
      type: 'SERVER_JS',
      source: forgePulse077ReadRepoText_('pulse-forge/core/ForgeCore.gs', 'main')
    },
    {
      name: 'ForgeValidator',
      type: 'SERVER_JS',
      source: forgePulse077ReadRepoText_('pulse-forge/core/ForgeValidator.gs', 'main')
    },
    {
      name: 'ForgeEngine',
      type: 'SERVER_JS',
      source: forgePulse077ReadRepoText_('pulse-forge/core/ForgeEngine.gs', 'main')
    },
    {
      name: 'appsscript',
      type: 'JSON',
      source: JSON.stringify(engineManifest, null, 2)
    }
  ];
  return forgeBuildInactiveEngine({
    taskId: 'PULSE-077',
    projectAlias: target,
    scriptId: project.scriptId,
    packageId: 'pulse-077-forge-engine-core',
    files: files,
    requiredFunctions: ['forgeEngineCoreSelfTest'],
    expectedHeadHash: current.packageHash,
    versionDescription: 'PULSE-077 Forge engine core',
    createTestDeployment: true,
    deploymentDescription: 'PULSE-077 inactive engine test'
  });
}

function forgePulse077ReadRepoText_(path, ref) {
  const encodedPath = forgeString_(path).split('/').map(encodeURIComponent).join('/');
  const result = forgeGitHubApi_('/contents/' + encodedPath + '?ref=' + encodeURIComponent(ref || 'main'), {
    method: 'get'
  });
  forgeAssert_(result && result.content && result.encoding === 'base64', 'GitHub file content was not returned for ' + path);
  const compact = forgeString_(result.content).replace(/\s/g, '');
  return Utilities.newBlob(Utilities.base64Decode(compact)).getDataAsString('UTF-8');
}
